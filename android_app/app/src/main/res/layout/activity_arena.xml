<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="8dp">

    <com.example.android_app.arena.ArenaView
        android:id="@+id/arenaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightPanel"
        app:layout_constraintDimensionRatio="1:1" />

    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/connectionBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="@color/status_bg" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            android:rowCount="3">

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="0"
                android:layout_column="0" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="0"
                android:layout_column="1"
                android:text="@string/btn_forward"
                android:textSize="24sp"
                android:contentDescription="Forward" />

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="0"
                android:layout_column="2" />

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="1"
                android:layout_column="0"
                android:text="@string/btn_left"
                android:textSize="24sp"
                android:contentDescription="Turn left" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="1"
                android:layout_column="1"
                android:text="@string/btn_stop"
                android:textSize="24sp"
                android:contentDescription="Stop" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="1"
                android:layout_column="2"
                android:text="@string/btn_right"
                android:textSize="24sp"
                android:contentDescription="Turn right" />

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="2"
                android:layout_column="0" />

            <Button
                android:id="@+id/btnBackward"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="2"
                android:layout_column="1"
                android:text="@string/btn_backward"
                android:textSize="24sp"
                android:contentDescription="Backward" />

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="2"
                android:layout_column="2" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start_run"
                android:contentDescription="Send start" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_reset"
                android:contentDescription="Reset arena" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_status_log"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/statusScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/status_bg"
            android:padding="6dp"
            tools:ignore="ScrollViewSize">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/status_text" />
        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
