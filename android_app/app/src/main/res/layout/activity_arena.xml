<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 1. Full-width top status bar -->
    <include
        android:id="@+id/connectionStatusBar"
        layout="@layout/connection_status_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Arena view constrained below the status bar -->
    <com.example.android_app.arena.ArenaView
        android:id="@+id/arenaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/rightPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/connectionStatusBar" />

    <!-- 3. Control Panel constrained below the status bar -->
    <LinearLayout
        android:id="@+id/rightPanel"
        android:layout_width="280dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/connectionStatusBar">

        <!-- Direction Controls -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:columnCount="3"
            android:rowCount="3">

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="0"
                android:layout_column="0" />

            <Button
                android:id="@+id/btnForward"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="0"
                android:layout_column="1"
                android:contentDescription="Forward"
                android:text="@string/btn_forward"
                android:textSize="24sp" />

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="0"
                android:layout_column="2" />

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="1"
                android:layout_column="0"
                android:contentDescription="Turn left"
                android:text="@string/btn_left"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="1"
                android:layout_column="1"
                android:contentDescription="Stop"
                android:text="@string/btn_stop"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="1"
                android:layout_column="2"
                android:contentDescription="Turn right"
                android:text="@string/btn_right"
                android:textSize="24sp" />

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="2"
                android:layout_column="0" />

            <Button
                android:id="@+id/btnBackward"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="2"
                android:layout_column="1"
                android:contentDescription="Backward"
                android:text="@string/btn_backward"
                android:textSize="24sp" />

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_row="2"
                android:layout_column="2" />
        </GridLayout>

        <!-- Start & Reset Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Send start"
                android:text="@string/btn_start_run" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="Reset arena"
                android:text="@string/btn_reset" />
        </LinearLayout>

        <!-- Console Log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_status_log"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/statusScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/status_bg"
            android:padding="6dp"
            tools:ignore="ScrollViewSize">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/status_text"
                android:textSize="12sp" />
        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>