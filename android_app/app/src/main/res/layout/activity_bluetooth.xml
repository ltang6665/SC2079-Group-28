<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/title_bluetooth"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/status_disconnected"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnScan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_scan"
        app:layout_constraintTop_toBottomOf="@id/statusView"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/btn_disconnect"
        app:layout_constraintTop_toTopOf="@id/btnScan"
        app:layout_constraintStart_toEndOf="@id/btnScan" />

    <TextView
        android:id="@+id/labelPaired"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/hint_paired_devices"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnScan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/labelDiscovered" />

    <TextView
        android:id="@+id/labelDiscovered"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Discovered devices"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/labelPaired"
        app:layout_constraintStart_toEndOf="@id/labelPaired"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pairedList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:background="#1A000000"
        app:layout_constraintTop_toBottomOf="@id/labelPaired"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/discoveredList"
        app:layout_constraintBottom_toTopOf="@id/labelLog"
        app:layout_constraintHeight_min="140dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/discoveredList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="#1A000000"
        app:layout_constraintTop_toBottomOf="@id/labelDiscovered"
        app:layout_constraintStart_toEndOf="@id/pairedList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/labelLog"
        app:layout_constraintHeight_min="140dp" />

    <TextView
        android:id="@+id/labelLog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_status_log"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/inboundLog" />

    <TextView
        android:id="@+id/inboundLog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/status_bg"
        android:textColor="@color/status_text"
        android:padding="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:scrollbars="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sendRow"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.22" />

    <LinearLayout
        android:id="@+id/sendRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/sendField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_message"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_send" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
